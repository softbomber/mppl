.rgt{word-wrap:break-word;text-overflow:ellipsis;display:table-cell;float:left}
.lft label{text-align:right;padding-right:3px} 
[data-tooltip]{position:relative}
[data-tooltip]:before{content:attr(data-tooltip);display:none;position:absolute;background:rgba(94,136,199,1);color:#fff;height:auto;padding:2px 5px;
line-height:1.4;max-width:110px; min-width:108px;border:1px solid #D8ECEF;word-wrap:break-word}
[data-tooltip-position="top"]:before,
[data-tooltip-position="bottom"]:before{left:50%; -ms-transform: translateX(-50%); -moz-transform: translateX(-50%); -webkit-transform: translateX(-50%);transform: translateX(-50%)} 
[data-tooltip-position="right"]:before, [data-tooltip-position="left"]:before{top:50%; -ms-transform:translateY(-50%); -moz-transform:translateY(-50%); -webkit-transform: translateY(-50%);transform: translateY(-50%)} 
[data-tooltip-position="top"]:before{bottom:100%;margin-bottom:6px} 
[data-tooltip-position="right"]:before{left:100%;margin-left:6px} 
[data-tooltip-position="bottom"]:before{top:100%;margin-top:6px} 
[data-tooltip-position="left"]:before{right:100%;margin-right:6px} 
[data-tooltip]:after{content:'';display:none;position:absolute;width:0;height:1px;border-color:transparent;border-style:solid}
[data-tooltip-position="top"]:after, [data-tooltip-position="bottom"]:after{left:50%;margin-left:-5px} 
[data-tooltip-position="right"]:after,[data-tooltip-position="left"]:after{top:50%;margin-top:-6px}
[data-tooltip-position="top"]:after{bottom: 100%;border-width:5px 4px 0;border-top-color:#D8ECEF}
[data-tooltip-position="right"]:after{left:99%;border-width:4px 4px 0;border-right-color:#D8ECEF}
[data-tooltip-position="bottom"]:after{top:100%;border-width: 0 6px 6px;border-bottom-color:#D8ECEF}
[data-tooltip-position="left"]:after {right:100%;border-width:6px 0 6px 6px;border-left-color:#D8ECEF}
[data-tooltip]:hover:before,[data-tooltip]:hover:after{display:block;z-index:50}
.pulse{position:absolute;top:-5px;left:-4px;width:30px;height:30px;-webkit-border-radius:50%;-moz-border-radius:50%;border-radius:50%; -webkit-box-sizing: border-box; -moz-box-sizing: border-box; -box-sizing: border-box}
.pulse1{border:5px solid #FEFDFF;-webkit-animation:pulse1 1s linear infinite; -moz-animation: pulse1 1s linear infinite;animation:pulse1 1s linear infinite} 
@-moz-keyframes pulse1{
0% {-moz-transform: scale(0);opacity:0} 
20% {-moz-transform: scale(.1);opacity:.1} 
40% {-moz-transform: scale(.2);opacity:.6} 
60% {-moz-transform: scale(.4);opacity:.8} 
100% {-moz-transform: scale(.6);opacity:0}} 
@-webkit-keyframes pulse1 { 
0% {-webkit-transform: scale(0);opacity:0} 
20% {-webkit-transform: scale(.1);opacity:.1}
40% {-webkit-transform: scale(.2);opacity:.6} 
60% {-webkit-transform: scale(.4);opacity:.8} 
100% {-webkit-transform: scale(.6);opacity:0}}
#sedia{position:relative;display:block}
#semail {display:inline-block;box-shadow: 0px 0px 3px 2px rgba(0,0,0,.5)}
#semail div{text-align: center; cursor: pointer; padding: 2px}
#semail ul{padding: 0px 10px 5px 10px;list-style:none}
#semail li{margin-bottom:5px}
#semail input{display:block;width: 225px}
/*#semail a {background:#999;color:#000;border-radius:5px;padding:0px 5px;text-decoration:none;transition:background 0.3s 0s;}*/
#semail a:hover{background:#333;color:#fff}
#semail .last{text-align:right}
.hMsg{animation: animationFrames ease-out .4s;animation-iteration-count:1;transform-origin: 50% 50%;-webkit-animation: animationFrames ease-out .4s;
-webkit-animation-iteration-count:1;-webkit-transform-origin:50% 50%;-moz-animation:animationFrames ease-out .4s;-moz-animation-iteration-count:1;
-moz-transform-origin:50% 50%;-o-animation:animationFrames ease-out .4s;-o-animation-iteration-count:1;-o-transform-origin:50% 50%;}
@keyframes animationFrames{ 0% {transform:translate(-35px,0);}100% { transform:translate(0,0); }}
@-moz-keyframes animationFrames{ 0% { -moz-transform:translate(-35px,0);}100% {-moz-transform:translate(0,0);}}
@-webkit-keyframes animationFrames { 0% {-webkit-transform:translate(-35px,0);}100% {-webkit-transform:translate(0,0);}}
@-o-keyframes animationFrames {0%{-o-transform: translate(-35px,0);}100% {-o-transform:translate(0,0);}}
.fCont{padding:14px 12px 9px}
.field{padding-bottom:3px;vertical-align:middle}
.news{display:table;font-size:12px;padding:2px}
.ndt{display:table-cell;width:50px;height:50px;background:#6495ed;text-align:center}
.article{display:table-cell;width:100%;color:#000}
.ntitle{background:#a9e2c2;color:#2c417f;font-weight:700;padding:4px}
.nn{background:aliceblue;padding:5px}
.mt{padding:0 7px;color:#fff}
.dt{font-size:25px;letter-spacing:-0.04em;padding:6px}
.yt{color:#fff89b;font-size:13px}
.clse{width:2.1em;height:2.1em;background:0;right:0;top:0;position:absolute;cursor:pointer;text-indent:-99999px}
.clse:after,.clse:before{background-color:#fff;content:"";display:inline-block;height:2px;position:absolute;left:.5em;top:1em;-moz-transform:rotate(45deg);
-webkit-transform:rotate(45deg);-o-transform:rotate(45deg);-ms-transform:rotate(45deg);transform:rotate(45deg);width:1.4em}
.clse:before{-moz-transform:rotate(-45deg);-webkit-transform:rotate(-45deg);-o-transform:rotate(-45deg);-ms-transform:rotate(-45deg);transform:rotate(-45deg);left:.5em}
/*#buy{margin-top: 5px;height: 34px;font:15px Trebuchet MS}*/
/*#buy:hover{background: rgba(94,136,199,.55);color:#6c97ff}*/

#buy {
    position: relative;
    vertical-align: top;
    width: 100%;
    height: 35px;
    padding: 0;
    font-size: 18px;
    color: #2d5e8a;
    text-align: center;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
    background: #ecf0f1;
    border: 0;
    border-bottom: 2px solid #cfe6ff;
    cursor: pointer;
    -webkit-box-shadow: inset 0 -2px #ecf3ff;
    box-shadow: inset 0 -2px #cfe6ff;
}
#buy:active {
    top: 1px;
    outline: none;
    -webkit-box-shadow: none;
    box-shadow: none;
}


a::after, .button::after {
    -moz-transform: scale(0.25);
    -webkit-transform: scale(0.25);
    -ms-transform: scale(0.25);
    transform: scale(0.25);
    -moz-pointer-events: none;
    -webkit-pointer-events: none;
    -ms-pointer-events: none;
    pointer-events: none;
    -moz-transition: opacity 0.2s ease, -moz-transform 0.2s ease;
    -webkit-transition: opacity 0.2s ease, -webkit-transform 0.2s ease;
    -ms-transition: opacity 0.2s ease, -ms-transform 0.2s ease;
    transition: opacity 0.2s ease, transform 0.2s ease;
    background: #ffffff;
    border-radius: 3em;
    content: '';
    height: 100%;
    left: 0;
    opacity: 0;
    position: absolute;
    top: 0;
    width: 100%;
}

.page-loader {
    width: 32px;
    height: 32px;
    border: 3px solid #FFF;
    border-radius: 999px;
    position: fixed;
    top: 50%;
    left: 50%;
    /* margin: -5px 0 0 14px; */
    display: none;
    z-index: 9999;
    -webkit-animation: pulsecircle .7s linear infinite;
    animation: pulsecircle .7s linear infinite;
}

@-webkit-keyframes pulsecircle{0%{-webkit-transform:scale(0.4,.4);opacity:0}50%{opacity:1}100%{-webkit-transform:scale(1.2,1.2);opacity:0}}
@keyframes pulsecircle{0%{transform:scale(0.1,.1);opacity:0}50%{opacity:1}100%{transform:scale(1.2,1.2);opacity:0}}