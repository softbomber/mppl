//top: 0px;
//left: 100%;z-index: 100;display: inline-block;margin-left: -20px;
//padding: 0px 4px;border: 2px solid rgb(212, 212, 212);border-radius: 5px;font-size: 11px;/* background: linear-gradient(to bottom, rgb(206, 112, 43) 0px, rgb(117, 22, 5) 100%) repeat scroll 0% 0% transparent; */}
.spinner{width:30px;height:30px;margin:auto;-webkit-animation: spin 1s infinite linear;-moz-animation: spin 1s infinite linear;animation:spin 1s infinite linear}
.spinn{margin:4px 0 0 4px;width:22px;height:22px;-webkit-animation: spinn 1s infinite linear;-moz-animation: spinn 1s infinite linear;animation:spinn 1s infinite linear}
.spinn,.spinner{display:block;position:fixed;border:3px solid rgba(10,10,10,0.6);border-top-color:transparent;border-radius:50%}
@-webkit-keyframes spin{to{-webkit-transform:rotate(-360deg)}}
@-moz-keyframes spin{to{-moz-transform:rotate(-360deg)}}
@keyframes spin{to{transform:rotate(-360deg)}}
@-webkit-keyframes spinn{to{-webkit-transform:rotate(360deg)}}
@-moz-keyframes spinn{to{-moz-transform:rotate(360deg)}}
@keyframes spinn{to{transform:rotate(360deg)}}
.spinsmall{width:15px;height:15px;margin:auto;display:block;position:fixed;border:3px solid rgba(0,0,0,0.6);border-top-color:transparent;border-radius:50%;-webkit-animation:spin 1s infinite linear;
-moz-animation: spin 1s infinite linear;animation: spin 1s infinite linear;}
@-webkit-keyframes spin { to { -webkit-transform: rotate(-360deg); }}
@-moz-keyframes spin { to { -moz-transform: rotate(-360deg); }}
@keyframes spin { to { transform: rotate(-360deg); }}
.spinnsmall{margin:4px 0 0 4px;width:11px;height:11px;display:block;position:fixed;border:3px solid rgba(10,10,10,0.6);border-top-color:transparent;border-radius:50%;-webkit-animation: spinn 1s infinite linear;
-moz-animation: spinn 1s infinite linear;animation: spinn 1s infinite linear}
@-webkit-keyframes spinn { to { -webkit-transform: rotate(360deg); }}
@-moz-keyframes spinn { to { -moz-transform: rotate(360deg); }}
@keyframes spinn { to { transform: rotate(360deg); }}
#toregister:target ~ #wrapper #register,
#tologin:target ~ #wrapper #login
#login-box:target ~ #login-box{z-index:22;animation-name:fadeInLeft;animation-delay: .1s}
.animate{animation-duration:.5s;animation-timing-function:ease;animation-fill-mode:both}
@keyframes fadeInLeft{0% {opacity:0;transform: translateX(-20px)}
100%{opacity:1;transform:translateX(0)}
}
#toregister:target ~ #wrapper #login,
#tologin:target ~ #wrapper #register{animation-name:fadeOutLeft}

@keyframes fadeOutLeft {0% {opacity: 1;transform: translateX(0)}
100%{opacity:0;transform:translateX(-20px)}
}

.circle{background:rgba(0,0,0,0);border:2px solid rgba(0,183,229,0.9);opacity:.9;border-left:2px solid rgba(0,0,0,0);border-right:2px solid rgba(0,0,0,0);
	border-radius:50px;box-shadow: 0 0 15px #2187e7;width:12px;	height:12px;position:relative;top:-19px;left:100px;-moz-animation:spinoffPulse 1s infinite linear;
	-webkit-animation:spinoffPulse 1s infinite linear}

@-moz-keyframes spinPulse {
	0% { -moz-transform:rotate(160deg); opacity:0; box-shadow:0 0 1px #2187e7;}
	50% { -moz-transform:rotate(145deg); opacity:1; }
	100% { -moz-transform:rotate(-320deg); opacity:0; }
}
@-moz-keyframes spinoffPulse {
	0% { -moz-transform:rotate(0deg); }
	100% { -moz-transform:rotate(360deg);  }
}
@-webkit-keyframes spinPulse {
	0% { -webkit-transform:rotate(160deg); opacity:0; box-shadow:0 0 1px #2187e7; }
	50% { -webkit-transform:rotate(145deg); opacity:1;}
	100% { -webkit-transform:rotate(-320deg); opacity:0; }
}
@-webkit-keyframes spinoffPulse {
	0% { -webkit-transform:rotate(0deg); }
	100% { -webkit-transform:rotate(360deg); }
}
