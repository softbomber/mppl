.tooltip span{position:absolute;bottom:30px;left:50%;z-index:999;width:230px;margin-left:-127px;padding:10px;border:2px solid rgb(204, 204,204);opacity:.9;background:rgb(221,221,221); 
	background-image:linear-gradient(rgba(255, 255, 255, 0.5),rgba(255,255,255,0));border-radius:4px;box-shadow:0px 1px 2px rgba(0,0,0,.4),0px 1px 0px rgba(255,255,255,.5) inset;
